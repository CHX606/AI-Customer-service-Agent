# LLM
API_KEY=
BASE_URL=
MODEL=gpt-5.5
MODEL_TIMEOUT_SECONDS=45
MODEL_MAX_RETRIES=1
IMAGE_UNDERSTANDING_MODEL=

# 会话持久化：留空时使用项目 data/sessions.db
SESSION_DB_PATH=

# Request Router V2 (复杂多轮请求仍自动回退 MODEL)
ROUTER_V2_ENABLED=1
ROUTER_MODEL=
ROUTER_TIMEOUT_SECONDS=5
ROUTER_MAX_RETRIES=0
CONTEXT_MODEL=
CONTEXT_TIMEOUT_SECONDS=15
CONTEXT_MAX_RETRIES=2
RESPONSE_MODEL=
RESPONSE_TIMEOUT_SECONDS=45
RESPONSE_MAX_RETRIES=1
RESPONSE_REASONING_EFFORT=low

# OpenSearch
OPENSEARCH_URL=https://localhost:9200
OPENSEARCH_USERNAME=admin
OPENSEARCH_PASSWORD=
OPENSEARCH_VERIFY_CERTS=0
OPENSEARCH_CA_CERTS=
OPENSEARCH_REQUEST_TIMEOUT=30
OPENSEARCH_INDEX_ALIAS=customer-service-knowledge
OPENSEARCH_INDEX_VERSION=v1
OPENSEARCH_SEARCH_PIPELINE=customer-service-hybrid-rrf-v1
OPENSEARCH_VECTOR_DIMENSION=512
OPENSEARCH_INDEX_SHARDS=1
OPENSEARCH_INDEX_REPLICAS=0
OPENSEARCH_BOOTSTRAP_ON_STARTUP=1

# API and tenants
APP_TENANT_ID=default
PUBLIC_CHAT_TENANTS=default
TENANT_ACCESS_KEYS=
ADMIN_AUTH_DISABLED=0
ADMIN_API_KEY=
TENANT_ADMIN_KEYS=

# Runtime performance
PRELOAD_RAG_MODELS=1
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RERANKER_BACKEND=onnx
RERANKER_MODEL_PATH=data/models/bge-reranker-v2-m3-onnx
RERANKER_ONNX_FILE=onnx/model_qint8_avx512.onnx
RERANKER_CANDIDATES=8
RERANKER_MAX_LENGTH=512
RERANKER_BATCH_SIZE=8
RERANKER_MAX_CONCURRENCY=2
RERANKER_QUEUE_TIMEOUT_SECONDS=30
SEMANTIC_CACHE_ENABLED=0
SEMANTIC_CACHE_THRESHOLD=0.93
SEMANTIC_CACHE_MAX_ENTRIES=1000

# Image understanding
IMAGE_SEMANTIC_ENABLED=1
IMAGE_SEMANTIC_MATCH_MAX_DISTANCE=4
IMAGE_SEMANTIC_DETAIL_MATCH_MAX_DISTANCE=24
IMAGE_VISION_FAILURE_COOLDOWN_SECONDS=120
