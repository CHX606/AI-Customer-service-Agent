{
  "version": 1,
  "name": "可乐云客服生产性能与覆盖测试集",
  "description": "同时评估知识库检索、端到端响应、外网常用应用问答、拒答边界和基础客服路由。coverage_gap 用例代表当前知识库尚需补充、但生产系统最终应该能够回答的内容。",
  "thresholds": {
    "retrieval": {
      "p95_ms": 800,
      "rerank_p95_ms": 1500,
      "hit_at_5": 0.9,
      "mrr": 0.75,
      "error_rate": 0.0
    },
    "http": {
      "first_event_p95_ms": 500,
      "retrieval_stage_p95_ms": 1200,
      "time_to_answer_p95_ms": 10000,
      "quality_pass_rate": 0.85,
      "error_rate": 0.0
    }
  },
  "cases": [
